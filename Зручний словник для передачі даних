-- Великий словник всіх предметів у грі (лежить ТІЛЬКИ НА СЕРВЕРІ)-- Де 101 і тд - ключі в середені яких лежать словники
local ItemsConfig = {
    [101] = {Name = "Іржавий Меч", Damage = 10, Price = 50},
    [102] = {Name = "Катана Самурая", Damage = 45, Price = 500},
    [105] = {Name = "Вогняний Меч", Damage = 90, Price = 1500}
}
-- Скрипт в кнопці магазину (на Клієнті)
RemoteEvent:FireServer(105)

--На сервері
-- Скрипт магазину
RemoteEvent.OnServerEvent:Connect(function(player, itemID)-- Де в параметр player ложиться інфа про гравця, а в itemID відповідні дані що були відправлені(в даному випадку число 105). ВАЖЛИВО пам'ятати про те що сревер ложит певні значення поступово, з ліва на право, тому якщо перша змінна буде названа не player, то буде тяжко зрозуміти що саме в ній лежить інфа про того хто відправив сигнал.
    
    -- Сервер бере число 105 і миттєво знаходить дані у своєму словнику!
    local itemData = ItemsConfig[itemID]
    
    -- Тепер сервер знає про цей предмет ВСЕ:
    print(player.Name .. " хоче купити " .. itemData.Name)
    print("Це коштує " .. itemData.Price .. " монет")
    
    -- Перевіряємо гроші гравця і даємо йому предмет
end)
